{
  "$schema": "https://modelscope.cn/api/v1/studios/deploy_schema.json",
  "sdk_type": "docker",
  "resource_configuration": "platform/2v-cpu-8g-mem",
  "environment_variables": [
    {
      "name": "OLLAMA_KV_CACHE_TYPE",
      "value": "q8_0"
    },
    {
      "name": "RAG_PRELOAD",
      "value": "0"
