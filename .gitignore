# ---- 虚拟环境 ----
venv/
.venv/
.python3.9/
.python3.10/

# ---- 模型（体积大，从 HuggingFace 重新下载）----
# 权重不入库；但 models/bge-m3/1_Pooling/config.json 是 sentence-transformers 装载
# 元文件（191B，modules.json 指向它）——infinity 的 ST 引擎启动必需，必须进 git 才能进
# 魔搭构建上下文（2026-10-31 实证）。gitignore 语义：父目录被排除后子文件不能重开，
# 需逐级"重开再排除"；且 models/* 的 * 不跨 /，重开 !models/bge-m3 后孙子层全部裸奔
# （实证 12 个文件含 pytorch_model.bin 解除忽略）——故每级都要补再排除行。
models/*
!models/bge-m3
models/bge-m3/*
!models/bge-m3/1_Pooling
models/bge-m3/1_Pooling/*
!models/bge-m3/1_Pooling/config.json

# ---- 索引产物与运行时缓存（可重建：process + index）----
# 入仓的是少数固定产物（artifacts/chunks.json、chunks.meta.json、gen_tokenizer/），其余
# 中间态（*.tmp.npz、.index.lock 等）一律忽略 —— 所以写"目录内白名单"而不是整目录忽略。
# corpus/ 被历史 git add -f 入仓（公开快照部署要用），同目录新增的大文件默认忽略；
# 已经 -f 入仓的文件不会被这里的规则影响，无需再改。
storage/
artifacts/*
!artifacts/chunks.json
!artifacts/chunks.meta.json
!artifacts/gen_tokenizer
!artifacts/gen_tokenizer/**
# index 成功收尾写的发布清单（chunk_fingerprint / lexicon_id / 集合名 / 分块数）：容器构建期
# verify-build 与 tools/ms_release.sh 都把它当唯一 EXPECTED_FP 来源，**必须入仓**。它与 storage/
# 是同一次 index 的产物，一起发布才能根治"数据落后于应用"（2026-10-31 923/350 事故）。
!artifacts/index_manifest.json
corpus/
*.pkl

# ---- 调研产物：GitHub 搜索结果（99KB，与代码无关）----
gh1.json

# ---- 本地缓存（infinity 模型影子视图等，可重建）----
.cache/
# 本地 Qdrant 原生存储与驱动等杂物（不入运行时产物清单，但同样永不入仓）
qdrant_storage/
chromedriver/

# ---- 本地原生二进制（如 qdrant，本地起用，不入仓）----
.bin/
*qdrant*.tar.gz

# ---- 运行时产物 ----
*.log
*.log.*
*.out
*.pid
.qdrant-initialized
debug_*.png

# ---- 本地备份 ----
bak/

# ---- 配置 ----
# .env 不忽略：是发布仓库的公开配置（部署启用面/构建产物策略），本来就无凭据；
# 凭据放 .streamlit/secrets.toml（严格忽略，*.bak 备份同样忽略）。
.streamlit/secrets.toml
.streamlit/secrets.toml.*

# ---- IDE ----
.idea/
.vscode/

# ---- Python ----
__pycache__/
*.pyc
*.pyo

# ---- macOS ----
.DS_Store
